# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# X32 Mixer (optional — set via web UI instead)
# Only used as fallback when no IP has been saved through the settings page.
# X32_HOST=192.168.1.100
# X32_PORT=10023

# Logging
LOG_LEVEL=debug

# Mock mode (true = no real hardware needed for testing)
MOCK_DEVICES=false
