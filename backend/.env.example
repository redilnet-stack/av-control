# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Settings file path (default: platform config dir, e.g. %APPDATA%/jersey-systems/settings.json)
# Set this to control exactly where device settings are persisted.
# SETTINGS_PATH=C:\Users\you\AppData\Roaming\jersey-systems\settings.json

# Device host fallbacks — used when the settings file is missing or has empty IPs.
# These are NOT the primary config; always save IPs through the Settings page.
# X32_HOST=192.168.1.100
# X32_PORT=10023
# ATEM_HOST=192.168.1.200
# ATEM_PORT=9910
# VIDEOHUB_HOST=192.168.1.210
# VIDEOHUB_PORT=9990

# Logging
LOG_LEVEL=debug

# Mock mode (true = no real hardware needed for testing)
MOCK_DEVICES=false
